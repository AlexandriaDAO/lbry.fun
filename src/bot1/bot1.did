type CostData = record { y_axis : vec float64; x_axis : vec nat64 };
type EpochCrossingAnalysis = record {
  multi_epoch_burns : vec MultiEpochBurn;
  single_epoch_burns : vec SingleEpochBurn;
};
type EpochData = record { y_axis : vec nat64; x_axis : vec text };
type EpochSnapshot = record {
  percentage_of_max_supply : float64;
  total_primary_minted_in_epoch : nat64;
  cumulative_secondary_burned : nat64;
  min_cost_in_epoch : float64;
  avg_cost_per_token_in_epoch : float64;
  cumulative_primary_minted : nat64;
  mint_rate : float64;
  total_loops_in_epoch : nat32;
  total_icp_spent_in_epoch : nat64;
  epoch_number : nat32;
  cumulative_icp_spent : nat64;
  halving_occurred : bool;
  total_secondary_burned_in_epoch : nat64;
  max_cost_in_epoch : float64;
};
type ExecutionError = variant {
  InvalidAmount : record { details : text; amount : nat64; reason : text };
  Underflow : record { operation : text; details : text };
  DivisionFailed : record { operation : text; details : text };
  MultiplicationOverflow : record { operation : text; details : text };
  AdditionOverflow : record { operation : text; details : text };
  RewardDistributionError : record { reason : text };
  RateLookupFailed : record { details : text };
  InsufficientBalance : record {
    token : text;
    available : nat64;
    details : text;
    required : nat64;
  };
  ConversionError : record { details : text };
  BurnFailed : record {
    token : text;
    details : text;
    amount : nat64;
    reason : text;
  };
  CanisterCallFailed : record {
    method : text;
    canister : text;
    details : text;
  };
  Unauthorized : text;
  InsufficientCanisterBalance : record {
    available : nat64;
    details : text;
    required : nat64;
  };
  MinimumRequired : record {
    token : text;
    provided : nat64;
    details : text;
    required : nat64;
  };
  TransferFailed : record {
    token : text;
    source : text;
    dest : text;
    details : text;
    amount : nat64;
    reason : text;
  };
  StateError : text;
  MintFailed : record {
    token : text;
    details : text;
    amount : nat64;
    reason : text;
  };
  InsufficientBalanceRewardDistribution : record {
    available : nat;
    details : text;
  };
};
type GraphData = record { y_axis : vec nat64; x_axis : vec nat64 };
type Log = record {
  function : text;
  log_type : LogType;
  log_id : nat64;
  timestamp : nat64;
  caller : principal;
};
type LogType = variant {
  Error : record { error : ExecutionError };
  Info : record { detail : text };
};
type LoopSnapshot = record {
  cost_per_primary : float64;
  cumulative_secondary_burned : nat64;
  loop_number : nat32;
  icp_spent : nat64;
  actual_mint_rate : float64;
  primary_received : nat64;
  cumulative_primary_minted : nat64;
  secondary_burned : nat64;
  cumulative_icp_spent : nat64;
  secondary_total_supply : nat64;
  secondary_received : nat64;
  secondary_dust : nat64;
  primary_total_supply : nat64;
};
type MultiEpochBurn = record {
  deviation_percent : float64;
  theoretical_breakdown : vec TheoreticalEpochContribution;
  loop_number : nat32;
  theoretical_total : nat64;
  actual_total : nat64;
  epochs_crossed : vec nat32;
};
type ObservedHalving = record {
  to_epoch : nat32;
  from_epoch : nat32;
  observed_percentage : float64;
};
type PaginatedLogs = record {
  page_size : nat64;
  logs : vec Log;
  total_pages : nat64;
  current_page : nat64;
};
type PaginatedTokenLogs = record {
  page_size : nat64;
  logs : vec TokenLogs;
  total_pages : nat64;
  current_page : nat64;
};
type PoolLogs = record {
  tokenomics_logs : opt PaginatedTokenLogs;
  icp_swap_logs : opt PaginatedLogs;
};
type PoolParameters = record {
  halving_step : nat64;
  initial_reward_per_burn_unit : nat64;
  primary_max_supply : nat64;
  initial_secondary_burn : nat64;
};
type PoolValidation = record {
  is_live : bool;
  estimated_cost_per_loop : nat64;
  token_record : opt TokenRecord;
  bot_icp_balance : nat64;
  pool_exists : bool;
  canisters_accessible : bool;
  launch_time : nat64;
};
type RateVerification = record {
  status : VerificationStatus;
  observed_halvings : vec ObservedHalving;
  configured_halving : nat32;
};
type Result = variant { Ok : text; Err : text };
type Result_1 = variant { Ok : PoolLogs; Err : text };
type Result_2 = variant { Ok : TokenomicsSchedule; Err : text };
type Result_3 = variant { Ok : ValidationSummary; Err : text };
type Result_4 = variant { Ok : ValidationTable; Err : text };
type Result_5 = variant { Ok : PoolValidation; Err : text };
type SingleEpochBurn = record {
  deviation_percent : float64;
  loop_number : nat32;
  epoch : nat32;
  expected_rate : float64;
  actual_rate : float64;
};
type SummaryData = record {
  total_minting_valuation : float64;
  percentage_of_max_supply : float64;
  average_cost_per_token : float64;
  final_mint_cost : float64;
  initial_mint_cost : float64;
  actual_total_minted : nat64;
  epochs_reached : nat32;
};
type TheoreticalEpochContribution = record {
  percentage_of_burn : float64;
  amount_burned : nat64;
  rate_4decimal : nat64;
  rate_human : float64;
  amount_minted : nat64;
  epoch_number : nat32;
};
type TokenInfo = record {
  secondary_token_id : text;
  tokenomics_canister_id : text;
  icp_swap_canister_id : text;
  primary_token_id : text;
};
type TokenLogType = variant {
  Error : record { error : TokenomicsExecutionError };
  Info : record { detail : text };
};
type TokenLogs = record {
  function : text;
  log_type : TokenLogType;
  log_id : nat64;
  timestamp : nat64;
  caller : principal;
};
type TokenRecord = record {
  id : nat64;
  secondary_token_symbol : text;
  secondary_token_id : principal;
  primary_token_name : text;
  tokenomics_canister_id : principal;
  secondary_token_name : text;
  primary_token_symbol : text;
  launch_delay_seconds : nat64;
  icp_swap_canister_id : principal;
  halving_step : nat64;
  primary_token_max_supply : nat64;
  pool_creation_failed : bool;
  initial_reward_per_burn_unit : nat64;
  initial_primary_mint : nat64;
  primary_token_id : principal;
  caller : principal;
  pool_created_at : nat64;
  distribution_interval_seconds : nat64;
  created_time : nat64;
  initial_secondary_burn : nat64;
  logs_canister_id : principal;
};
type TokenomicsExecutionError = variant {
  Underflow : record { operation : text; details : text };
  DivisionFailed : record { operation : text; details : text };
  MultiplicationOverflow : record { operation : text; details : text };
  AdditionOverflow : record { operation : text; details : text };
  CanisterCallFailed : record {
    method : text;
    canister : text;
    details : text;
  };
  NoMorePrimaryCanBeMinted : record { reason : text };
  MaxMintPrimaryReached : record { reason : text };
  MintFailed : record {
    token : text;
    details : text;
    amount : nat64;
    reason : text;
  };
  MaxPrimaryPerTrnxReached : record { reason : text };
};
type TokenomicsSchedule = record {
  rewards : vec nat64;
  thresholds : vec nat64;
};
type ValidationSummary = record {
  total_loops : nat32;
  average_cost_per_token : float64;
  largest_multi_epoch_burn : opt MultiEpochBurn;
  total_usd_cost : float64;
  analysis_warnings : vec text;
  total_icp_spent : nat64;
  average_mint_rate : float64;
  first_loop : LoopSnapshot;
  epoch_snapshots : vec EpochSnapshot;
  last_loop : LoopSnapshot;
  pool_parameters : PoolParameters;
  pool_id : nat64;
  epochs_reached : nat32;
  token_info : TokenInfo;
  rate_verification : opt RateVerification;
  epoch_analysis : opt EpochCrossingAnalysis;
  final_percentage_minted : float64;
};
type ValidationTable = record {
  total_loops : nat32;
  total_usd_cost : float64;
  total_dust_accumulated : nat64;
  snapshots : vec LoopSnapshot;
  cumulative_supply_data : GraphData;
  cumulative_percentage_supply_data : CostData;
  cumulative_usd_cost_data : GraphData;
  total_icp_spent : nat64;
  average_mint_rate : float64;
  total_primary_minted : nat64;
  cost_to_mint_data : CostData;
  total_secondary_burned : nat64;
  summary_data : SummaryData;
  pool_parameters : PoolParameters;
  pool_id : nat64;
  minted_per_epoch_data : EpochData;
  token_info : TokenInfo;
};
type VerificationStatus = variant {
  Mismatch : record { observed : float64; expected : float64 };
  Verified;
  InsufficientData;
};
service : () -> {
  execute_loops : (nat64, nat64, nat32) -> (Result);
  get_bot_principal : () -> (text) query;
  get_pool_logs : (nat64, opt nat64, opt nat64) -> (Result_1);
  get_pool_tokenomics_schedule : (nat64) -> (Result_2);
  get_summary : (nat64) -> (Result_3);
  get_table : (nat64) -> (Result_4);
  validate_pool : (nat64) -> (Result_5);
}

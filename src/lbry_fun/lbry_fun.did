type AdminCleanupOptions = record {
  force_refund : bool;
  remove_record : bool;
  force_delete_canisters : bool;
};
type CreateTokenParams = record {
  secondary_token_symbol : text;
  primary_token_name : text;
  secondary_token_description : text;
  secondary_token_name : text;
  primary_token_symbol : text;
  launch_delay_seconds : nat64;
  primary_logo : text;
  halving_step : nat64;
  primary_token_description : text;
  initial_reward_per_burn_unit : nat64;
  initial_primary_mint : nat64;
  threshold_multiplier : float64;
  secondary_logo : text;
  distribution_interval_seconds : nat64;
  primary_max_supply : nat64;
  initial_secondary_burn : nat64;
};
type DeploymentInfo = record {
  id : nat64;
  last_error : opt text;
  status : text;
  canister_count : nat64;
  token_id : opt nat64;
  cleanup_progress : nat8;
  failed_at : opt nat64;
  created_at : nat64;
  last_activity : nat64;
};
type EpochData = record {
  primary_minted_this_epoch_e8s : nat;
  cumulative_primary_minted_e8s : nat;
  cost_per_primary_token_usd : float64;
  epoch_number : nat32;
  secondary_burned_this_epoch_e8s : nat;
  cumulative_secondary_burned_e8s : nat;
};
type GraphData = record {
  cost_to_mint_data_x : vec nat64;
  cost_to_mint_data_y : vec float64;
  cumulative_usd_cost_data_x : vec nat64;
  cumulative_usd_cost_data_y : vec float64;
  cumulative_supply_data_x : vec nat64;
  cumulative_supply_data_y : vec nat64;
  minted_per_epoch_data_x : vec text;
  minted_per_epoch_data_y : vec nat64;
};
type PreviewArgs = record {
  halving_step : nat64;
  initial_reward_per_burn_unit : nat64;
  threshold_multiplier : opt float64;
  tge_allocation : nat64;
  primary_max_supply : nat64;
  initial_secondary_burn : nat64;
};
type Result = variant { Ok : text; Err : text };
type Result_1 = variant { Ok : vec text; Err : text };
type Result_2 = variant { Ok : nat; Err : TransferFromError };
type Result_3 = variant { Ok : TokenDeploymentResult; Err : text };
type Result_4 = variant { Ok : nat; Err : text };
type Result_5 = variant { Ok : GraphData; Err : text };
type Result_6 = variant { Ok : nat64; Err : text };
type StuckDeploymentInfo = record {
  id : nat64;
  cleanup_attempts : nat8;
  last_error : opt text;
  status : text;
  payment_amount : nat64;
  deleted_canisters : vec principal;
  user : principal;
  created_at : nat64;
  created_canisters : vec principal;
};
type TokenDeploymentResult = record { token_id : nat64; message : text };
type TokenRecord = record {
  id : nat64;
  secondary_token_symbol : text;
  secondary_token_id : principal;
  primary_token_name : text;
  tokenomics_canister_id : principal;
  secondary_token_name : text;
  primary_token_symbol : text;
  launch_delay_seconds : nat64;
  icp_swap_canister_id : principal;
  halving_step : nat64;
  primary_token_max_supply : nat64;
  pool_creation_failed : bool;
  initial_reward_per_burn_unit : nat64;
  initial_primary_mint : nat64;
  threshold_multiplier : float64;
  primary_token_id : principal;
  caller : principal;
  pool_created_at : nat64;
  distribution_interval_seconds : nat64;
  created_time : nat64;
  initial_secondary_burn : nat64;
  logs_canister_id : principal;
};
type TokenStatus = record {
  launch_delay_seconds : nat64;
  pool_creation_failed : bool;
  pool_created_at : nat64;
  created_time : nat64;
};
type TokenStatusDetail = record {
  is_live : bool;
  secondary_token_symbol : text;
  token_id : nat64;
  primary_token_symbol : text;
  pool_creation_failed : bool;
  pool_created_at : nat64;
  created_time : nat64;
  time_until_live_nanos : nat64;
};
type TokenomicsSchedule = record {
  epochs : vec EpochData;
  total_supply_percentage : float64;
  total_epochs : nat32;
};
type TransferFromError = variant {
  GenericError : record { message : text; error_code : nat };
  TemporarilyUnavailable;
  InsufficientAllowance : record { allowance : nat };
  BadBurn : record { min_burn_amount : nat };
  Duplicate : record { duplicate_of : nat };
  BadFee : record { expected_fee : nat };
  CreatedInFuture : record { ledger_time : nat64 };
  TooOld;
  InsufficientFunds : record { balance : nat };
};
service : () -> {
  admin_force_cleanup : (nat64, AdminCleanupOptions) -> (Result);
  admin_retry_failed_refunds : () -> (Result_1);
  create_token : (
      text,
      text,
      text,
      text,
      text,
      text,
      text,
      text,
      nat64,
      nat64,
      nat64,
      nat64,
      float64,
      nat64,
      nat64,
      nat64,
    ) -> (Result);
  deposit_icp_in_canister : (nat64, opt blob) -> (Result_2);
  execute_token_deployment : (nat64) -> (Result_3);
  get_all_token_record : () -> (vec record { nat64; TokenRecord }) query;
  get_canister_cycle_balance : (principal) -> (Result_4);
  get_live : () -> (vec record { nat64; TokenRecord }) query;
  get_my_deployments : () -> (vec DeploymentInfo) query;
  get_stuck_deployments : () -> (vec StuckDeploymentInfo) query;
  get_token_status : (nat64) -> (opt TokenStatusDetail) query;
  get_token_status_by_swap_canister : (principal) -> (opt TokenStatus) query;
  get_tokenomics_graphs : (nat64) -> (Result_5) query;
  get_treasury_balance : () -> (Result_6) query;
  get_upcomming : () -> (vec record { nat64; TokenRecord }) query;
  initiate_token_deployment : (CreateTokenParams) -> (Result_6);
  migrate_v9_deployments : () -> (text);
  preview_tokenomics_graphs : (PreviewArgs) -> (GraphData);
  preview_tokenomics_schedule : (
      nat64,
      nat64,
      nat64,
      nat64,
      nat64,
      float64,
    ) -> (TokenomicsSchedule);
  recover_stuck_deployment : () -> (Result);
  retry_pool_creation : (nat64) -> (Result);
}

type AdminCleanupOptions = record {
  force_refund : bool;
  remove_record : bool;
  force_delete_canisters : bool;
};
type AuditState = record {
  last_successful_collection : nat64;
  expected_value : nat64;
  de_peg_detected : bool;
  consecutive_failures : nat32;
  total_value_locked : nat64;
};
type CollectionMetrics = record {
  last_successful_collection : nat64;
  collection_efficiency_basis_points : nat32;
  failed_collections_24h : nat32;
  total_accumulated_icp : nat64;
  average_collection_interval : nat64;
  total_burned_lbry : nat64;
};
type CreateTokenParams = record {
  secondary_token_symbol : text;
  primary_token_name : text;
  secondary_token_description : text;
  secondary_token_name : text;
  primary_token_symbol : text;
  launch_delay_seconds : nat64;
  primary_logo : text;
  halving_step : nat64;
  primary_token_description : text;
  initial_reward_per_burn_unit : nat64;
  initial_primary_mint : nat64;
  threshold_multiplier : float64;
  secondary_logo : text;
  distribution_interval_seconds : nat64;
  primary_max_supply : nat64;
  initial_secondary_burn : nat64;
};
type DeploymentInfo = record {
  id : nat64;
  last_error : opt text;
  status : text;
  canister_count : nat64;
  token_id : opt nat64;
  cleanup_progress : nat8;
  failed_at : opt nat64;
  created_at : nat64;
  last_activity : nat64;
};
type EpochData = record {
  primary_minted_this_epoch_e8s : nat;
  cumulative_primary_minted_e8s : nat;
  cost_per_primary_token_usd : float64;
  epoch_number : nat32;
  secondary_burned_this_epoch_e8s : nat;
  cumulative_secondary_burned_e8s : nat;
};
type GraphData = record {
  cost_to_mint_data_x : vec nat64;
  cost_to_mint_data_y : vec float64;
  cumulative_usd_cost_data_x : vec nat64;
  cumulative_usd_cost_data_y : vec float64;
  cumulative_supply_data_x : vec nat64;
  cumulative_supply_data_y : vec nat64;
  minted_per_epoch_data_x : vec text;
  minted_per_epoch_data_y : vec nat64;
};
type PreviewArgs = record {
  halving_step : nat64;
  initial_reward_per_burn_unit : nat64;
  threshold_multiplier : opt float64;
  tge_allocation : nat64;
  primary_max_supply : nat64;
  initial_secondary_burn : nat64;
};
type ReconciliationDetail = record {
  token_id : principal;
  reconciliation : ReconciliationStatus;
  icp_swap_canister : principal;
};
type ReconciliationStatus = record {
  operational_balance_suspicious : bool;
  canister_id : principal;
  total_staked : nat64;
  uncollected_lp_fees : nat64;
  icp_balance_expected : nat64;
  discrepancy_e8s : int64;
  icp_balance_actual : nat64;
  reward_pool : nat64;
  uncollected_alex_fees : nat64;
  timestamp : nat64;
  requires_attention : bool;
  operational_balance : nat64;
};
type Result = variant { Ok : text; Err : text };
type Result_1 = variant { Ok : vec text; Err : text };
type Result_2 = variant { Ok : nat; Err : TransferFromError };
type Result_3 = variant { Ok : TokenDeploymentResult; Err : text };
type Result_4 = variant { Ok : nat; Err : text };
type Result_5 = variant { Ok : ReconciliationDetail; Err : text };
type Result_6 = variant { Ok : TokenStatus; Err : text };
type Result_7 = variant { Ok : GraphData; Err : text };
type Result_8 = variant { Ok : nat64; Err : text };
type StuckDeploymentInfo = record {
  id : nat64;
  cleanup_attempts : nat8;
  last_error : opt text;
  status : text;
  payment_amount : nat64;
  deleted_canisters : vec principal;
  user : principal;
  created_at : nat64;
  created_canisters : vec principal;
};
type SwapState = variant {
  Failed : record { error : text; timestamp : nat64 };
  Collecting : record { started_at : nat64 };
  Idle;
  Burning : record { lbry_amount : nat64; started_at : nat64 };
  Swapping : record { amount : nat64; started_at : nat64 };
};
type SystemReconciliationSummary = record {
  tokens_with_discrepancies : vec principal;
  total_uncollected_alex : nat64;
  total_expected_fees : nat64;
  timestamp : nat64;
  total_uncollected_lp : nat64;
};
type TokenDeploymentResult = record { token_id : nat64; message : text };
type TokenFailureInfo = record {
  last_error : text;
  token_id : principal;
  uncollected_amount : nat64;
  consecutive_failures : nat32;
};
type TokenHealthSummary = record {
  healthy_tokens : nat32;
  unhealthy_tokens : nat32;
  stagnant_tokens : vec principal;
  tokens_with_failures : vec TokenFailureInfo;
};
type TokenRecord = record {
  id : nat64;
  status : TokenStatus;
  secondary_token_symbol : text;
  secondary_token_id : principal;
  primary_token_name : text;
  tokenomics_canister_id : principal;
  secondary_token_name : text;
  primary_token_symbol : text;
  launch_delay_seconds : nat64;
  launched_at : nat64;
  icp_swap_canister_id : principal;
  halving_step : nat64;
  primary_token_max_supply : nat64;
  initial_reward_per_burn_unit : nat64;
  initial_primary_mint : nat64;
  threshold_multiplier : float64;
  primary_token_id : principal;
  caller : principal;
  distribution_interval_seconds : nat64;
  created_time : nat64;
  initial_secondary_burn : nat64;
  logs_canister_id : principal;
};
type TokenStatus = variant {
  Failed : record { reason : text };
  Live : record { pool_id : text };
  Deploying : record { progress : nat8 };
};
type TokenStatusDetail = record {
  is_live : bool;
  status : TokenStatus;
  secondary_token_symbol : text;
  token_id : nat64;
  primary_token_symbol : text;
  time_until_live_nanos : nat64;
};
type TokenomicsSchedule = record {
  epochs : vec EpochData;
  total_supply_percentage : float64;
  total_epochs : nat32;
};
type TransferFromError = variant {
  GenericError : record { message : text; error_code : nat };
  TemporarilyUnavailable;
  InsufficientAllowance : record { allowance : nat };
  BadBurn : record { min_burn_amount : nat };
  Duplicate : record { duplicate_of : nat };
  BadFee : record { expected_fee : nat };
  CreatedInFuture : record { ledger_time : nat64 };
  TooOld;
  InsufficientFunds : record { balance : nat };
};
service : () -> {
  // Force cleanup of a specific deployment
  admin_force_cleanup : (nat64, AdminCleanupOptions) -> (Result);
  // Retry failed refunds
  admin_retry_failed_refunds : () -> (Result_1);
  create_token : (
      text,
      text,
      text,
      text,
      text,
      text,
      text,
      text,
      nat64,
      nat64,
      nat64,
      nat64,
      float64,
      nat64,
      nat64,
      nat64,
    ) -> (Result);
  deposit_icp_in_canister : (nat64, opt blob) -> (Result_2);
  // Phase 2: Execute the deployment with the given ID
  execute_token_deployment : (nat64) -> (Result_3);
  // Quick fix to remove stuck tokens with failed pool creation
  fix_stuck_token : (nat64) -> (Result);
  get_all_token_record : () -> (vec record { nat64; TokenRecord }) query;
  get_audit_state : () -> (AuditState) query;
  get_canister_cycle_balance : (principal) -> (Result_4);
  get_collection_metrics : () -> (CollectionMetrics) query;
  get_collection_status : () -> (SwapState, nat64) query;
  get_failed : () -> (vec record { nat64; TokenRecord }) query;
  get_live : () -> (vec record { nat64; TokenRecord }) query;
  // Query deployment status and history
  get_my_deployments : () -> (vec DeploymentInfo) query;
  get_problematic_tokens : () -> (vec record { principal; nat32 }) query;
  // Get deployments that need manual intervention
  get_stuck_deployments : () -> (vec StuckDeploymentInfo) query;
  get_system_reconciliation : () -> (SystemReconciliationSummary) query;
  get_token_detail : (nat64) -> (opt TokenStatusDetail) query;
  get_token_health_summary : () -> (TokenHealthSummary) query;
  get_token_reconciliation : (nat64) -> (Result_5) query;
  get_token_status : (nat64) -> (Result_6) query;
  get_tokenomics_graphs : (nat64) -> (Result_7) query;
  get_treasury_balance : () -> (Result_8) query;
  get_upcoming : () -> (vec record { nat64; TokenRecord }) query;
  // Phase 1: Create deployment and return ID immediately
  initiate_token_deployment : (CreateTokenParams) -> (Result_8);
  // Migrate V9 deployments to V10 format
  migrate_v9_deployments : () -> (text);
  preview_tokenomics_graphs : (PreviewArgs) -> (GraphData);
  preview_tokenomics_schedule : (
      nat64,
      nat64,
      nat64,
      nat64,
      nat64,
      float64,
    ) -> (TokenomicsSchedule);
  // Allow users to recover stuck deployments based on activity
  recover_stuck_deployment : () -> (Result);
  retry_pool_creation : (nat64) -> (Result);
}
